{
  "name": "doyouevenlogbro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-dyelb",
    "test:rules:ci": "firebase emulators:exec --only firestore --project demo-dyelb \"npm run test:rules\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill": "tsx scripts/backfill-game.ts",
    "grant-items": "tsx scripts/grant-items.ts",
    "e2e": "node e2e/free-ports.mjs && firebase emulators:exec --only firestore,auth --project demo-dyelb \"playwright test -c e2e/playwright.config.ts\"",
    "e2e:headed": "node e2e/free-ports.mjs && firebase emulators:exec --only firestore,auth --project demo-dyelb \"playwright test -c e2e/playwright.config.ts --headed\"",
    "e2e:seed": "tsx e2e/seed.ts",
    "e2e:cleanup": "node e2e/free-ports.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
