rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validHandle(handle) {
      return handle is string && handle.matches('^[a-z0-9_]{3,20}$');
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function followerPath(uid, followerUid) {
      return /databases/$(database)/documents/users/$(uid)/followers/$(followerUid);
    }

    function followingPath(uid, targetUid) {
      return /databases/$(database)/documents/users/$(uid)/following/$(targetUid);
    }

    function requestPath(uid, requesterUid) {
      return /databases/$(database)/documents/users/$(uid)/followRequests/$(requesterUid);
    }

    // Workouts (and their likes/comments) are readable by the owner, by anyone (signed in or not,
    // e.g. via a shared link) when the owner's account is public, and by approved followers when it's private.
    function canReadWorkouts(uid) {
      return isUser(uid)
        || get(userPath(uid)).data.isPrivate == false
        || (signedIn() && exists(followerPath(uid, request.auth.uid)));
    }

    // Follow docs hold only the server time they were made.
    function validFollowDoc() {
      return request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // A profile picture: a link (e.g. the Google account photo), or one the user uploaded,
    // stored inline as a small JPEG data URL. Must match MAX_AVATAR_CHARS in src/lib/image.ts.
    function validPhotoURL(photo) {
      return photo == null
        || (photo is string && photo.size() <= 2048 && !photo.matches('^data:.*'))
        || (photo is string
          && photo.size() <= 40000
          && photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$'));
    }

    function handlePath(handle) {
      return /databases/$(database)/documents/usernames/$(handle);
    }

    // A username + password account's hidden sign-in address (see LOGIN_DOMAIN in src/lib/profile.ts),
    // and only the signed-in user's own, so a handle can't point at anyone else's login.
    function validLoginEmail(data) {
      return !('loginEmail' in data)
        || (data.loginEmail == request.auth.token.email
          && data.loginEmail.matches('^[^@]+@login[.]doyouevenlogbro[.]vercel[.]app$'));
    }

    // usernames/{handle} -> { uid, loginEmail? }. Written only together with the user doc
    // (onboarding transaction or username-change batch), so a handle can't be hijacked.
    match /usernames/{handle} {
      // Readable signed out: signing in with a username looks up its loginEmail here.
      allow get: if true;
      allow list: if false;
      // Create only: a batch set() on an existing handle is an update, which is denied,
      // so nobody can take a handle that's already claimed.
      allow create: if signedIn()
        && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid', 'loginEmail'])
        && request.resource.data.uid == request.auth.uid
        && validLoginEmail(request.resource.data)
        && getAfter(userPath(request.auth.uid)).data.username == handle;
      allow update: if false;
      // Only your own handle, and only when the same batch moves your profile off it.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.username != handle;
    }

    match /users/{uid} {
      function validProfile(data) {
        return data.keys().hasOnly(['username', 'usernameChangedAt', 'displayName', 'photoURL', 'unit', 'isPrivate', 'createdAt', 'bio'])
          && validHandle(data.username)
          && data.usernameChangedAt is timestamp
          && data.displayName is string && data.displayName.size() <= 50
          && validPhotoURL(data.photoURL)
          && data.unit in ['kg', 'lb']
          && data.isPrivate is bool
          && data.createdAt is number
          // Must match MAX_BIO_LENGTH in src/lib/profile.ts.
          && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300));
      }

      function usernameUnchanged() {
        return request.resource.data.username == resource.data.username
          && request.resource.data.usernameChangedAt == resource.data.usernameChangedAt;
      }

      // Once a week: the old handle is released and the new one is claimed in the same batch.
      function validUsernameChange() {
        let oldHandle = resource.data.username;
        let newHandle = request.resource.data.username;
        return newHandle != oldHandle
          && request.time >= resource.data.usernameChangedAt + duration.value(7, 'd')
          && request.resource.data.usernameChangedAt == request.time
          && getAfter(handlePath(newHandle)).data.uid == uid
          && !existsAfter(handlePath(oldHandle));
      }

      // A single profile is public (shared workout links show the author); listing needs sign-in.
      allow get: if true;
      allow list: if signedIn();
      allow create: if isUser(uid)
        && validProfile(request.resource.data)
        && request.resource.data.usernameChangedAt == request.time
        && getAfter(handlePath(request.resource.data.username)).data.uid == uid;
      allow update: if isUser(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (usernameUnchanged() || validUsernameChange());
      // Account deletion goes through the Admin SDK, which bypasses rules.
      allow delete: if false;

      match /workouts/{workoutId} {
        function validWorkout(data) {
          return data.keys().hasOnly(['name', 'startedAt', 'endedAt', 'exercises', 'exerciseIds', 'volumeKg', 'setCount', 'description', 'hasPhoto', 'recordCount'])
            && (!('recordCount' in data) || (data.recordCount is int && data.recordCount >= 0 && data.recordCount <= 1000))
            // Must match MAX_DESCRIPTION_LENGTH in src/lib/draft.ts.
            && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
            && (!('hasPhoto' in data) || data.hasPhoto is bool)
            && data.name is string && data.name.size() <= 100
            && data.startedAt is number
            && data.endedAt is number && data.endedAt >= data.startedAt
            && data.exercises is list && data.exercises.size() <= 50
            && data.exerciseIds is list && data.exerciseIds.size() <= 50
            && data.volumeKg is number
            && data.setCount is int && data.setCount <= 1000;
        }

        function workoutPath() {
          return /databases/$(database)/documents/users/$(uid)/workouts/$(workoutId);
        }

        allow read: if canReadWorkouts(uid);
        allow delete: if isUser(uid);
        allow create, update: if isUser(uid) && validWorkout(request.resource.data);

        // users/{uid}/workouts/{id}/photos/main: the workout photo as a JPEG data URL, kept out of
        // the workout doc so lists don't download it. Must match MAX_WORKOUT_PHOTO_CHARS in src/lib/image.ts.
        match /photos/{photoId} {
          allow read: if canReadWorkouts(uid);
          allow create, update: if isUser(uid)
            && photoId == 'main'
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 800000
            && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$');
          allow delete: if isUser(uid);
        }

        // users/{uid}/workouts/{id}/likes/{likerUid}: one like per user, id = liker's uid.
        match /likes/{likerUid} {
          allow read: if canReadWorkouts(uid);
          allow create: if signedIn()
            && request.auth.uid == likerUid
            && canReadWorkouts(uid)
            && exists(workoutPath())
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          // The liker can unlike; the workout owner can clear likes when deleting the workout.
          allow delete: if signedIn() && (request.auth.uid == likerUid || request.auth.uid == uid);
          allow update: if false;
        }

        match /comments/{commentId} {
          function commentPath(id) {
            return /databases/$(database)/documents/users/$(uid)/workouts/$(workoutId)/comments/$(id);
          }

          // Replies are one level deep: parentId must point at an existing top-level comment.
          function validReply(data) {
            return (!('parentId' in data)
                || (data.parentId is string
                  && exists(commentPath(data.parentId))
                  && !('parentId' in get(commentPath(data.parentId)).data)))
              && (!('replyToUsername' in data) || ('parentId' in data && validHandle(data.replyToUsername)));
          }

          allow read: if canReadWorkouts(uid);
          // Author fields must match the commenter's real profile, so nobody can post as someone else.
          allow create: if signedIn()
            && canReadWorkouts(uid)
            && exists(workoutPath())
            && request.resource.data.keys().hasOnly(['authorUid', 'authorUsername', 'authorPhotoURL', 'text', 'createdAt', 'parentId', 'replyToUsername'])
            && validReply(request.resource.data)
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUsername == get(userPath(request.auth.uid)).data.username
            && validPhotoURL(request.resource.data.authorPhotoURL)
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;
          // The author can delete their comment; the workout owner can delete any comment on it;
          // and a comment's author can delete the replies under it (deleting a thread removes its replies).
          allow delete: if signedIn()
            && (resource.data.authorUid == request.auth.uid
              || request.auth.uid == uid
              || ('parentId' in resource.data
                && get(commentPath(resource.data.parentId)).data.authorUid == request.auth.uid));
          allow update: if false;
        }
      }

      // users/{uid}/following/{targetUid} (uid follows targetUid) is always mirrored by
      // users/{targetUid}/followers/{uid}; both are written and deleted in the same batch.
      match /following/{targetUid} {
        allow read: if signedIn();
        // The follower follows, or the target approves the follower's request.
        allow create: if validFollowDoc()
          && uid != targetUid
          && existsAfter(followerPath(targetUid, uid))
          && (isUser(uid) || (isUser(targetUid) && exists(requestPath(targetUid, uid))));
        // Unfollowing, or the target removing a follower.
        allow delete: if isUser(uid) || isUser(targetUid);
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        // Anyone can follow a public account; a private account's owner approves a pending request.
        allow create: if validFollowDoc()
          && uid != followerUid
          && existsAfter(followingPath(followerUid, uid))
          && ((isUser(followerUid) && get(userPath(uid)).data.isPrivate == false)
            || (isUser(uid) && exists(requestPath(uid, followerUid))));
        allow delete: if isUser(uid) || isUser(followerUid);
        allow update: if false;
      }

      // users/{uid}/followRequests/{requesterUid}: asking to follow a private account.
      match /followRequests/{requesterUid} {
        // The owner lists their requests; a requester can check on their own.
        allow get: if isUser(uid) || isUser(requesterUid);
        allow list: if isUser(uid);
        allow create: if isUser(requesterUid)
          && uid != requesterUid
          && validFollowDoc()
          && get(userPath(uid)).data.isPrivate == true
          && !exists(followerPath(uid, requesterUid));
        // Accepting/declining (owner) or cancelling (requester).
        allow delete: if isUser(uid) || isUser(requesterUid);
        allow update: if false;
      }

      match /routines/{routineId} {
        function validRoutine(data) {
          return data.keys().hasOnly(['name', 'exercises', 'updatedAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.exercises is list && data.exercises.size() > 0 && data.exercises.size() <= 50
            && data.updatedAt is number;
        }

        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && validRoutine(request.resource.data);
      }

      match /customExercises/{exerciseId} {
        function validExercise(data) {
          return data.keys().hasOnly(['name', 'muscle', 'equipment', 'category', 'imageData'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 80
            && data.muscle is string && data.muscle.size() <= 40
            && data.equipment is string && data.equipment.size() <= 40
            && data.category is string && data.category.size() <= 40
            && (!('imageData' in data) || validImage(data.imageData));
        }

        // Optional photo: a small JPEG data URL (the app makes 192px thumbnails, ~10-25 KB).
        // Must match MAX_IMAGE_DATA_CHARS in src/lib/image.ts.
        function validImage(image) {
          return image is string
            && image.size() <= 150000
            && image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$');
        }

        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && exerciseId.matches('^c_[A-Za-z0-9]+$')
          && validExercise(request.resource.data);
      }
    }
  }
}
